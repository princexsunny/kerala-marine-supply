# Copy this file to .env and fill in your own values. Never commit .env.

PORT=3000

# Firebase — Project Settings > Service Accounts > Generate new private key.
# Paste the JSON file's fields here (keep the quotes around the private key).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENTS\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Admin page (admin.html / Admin.dc.html) HTTP Basic Auth login.
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-password
